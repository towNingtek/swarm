# Swarm platform settings. Copy to /etc/swarm/platform.env (root:swarm, 0640).
# Plain KEY=value lines only: the root-owned helper scripts read a few keys
# from this file without executing it. Secrets do NOT go here; they are files
# in $SWARM_SECRETS_DIR (see deploy/README.md).

# --- where things are ---------------------------------------------------
SWARM_HOME=/opt/swarm                      # this repository
SWARM_PYTHON=/opt/swarm/.venv/bin/python
SWARM_STATE=/var/lib/swarm/platform        # database and logs
SWARM_SECRETS_DIR=/etc/swarm/secrets

# --- public addresses -----------------------------------------------------
PLATFORM_ORIGIN=https://platform.example.com
ADMIN_ORIGIN=https://platform.example.com  # normally the same origin, under /admin
SWARM_DOMAIN=example.com                   # sites are <name>.example.com

# --- sites ------------------------------------------------------------------
SWARM_SITES_ROOT=/var/lib/swarm/sites
SWARM_SITE_IMAGE=swarm-site:latest
SWARM_SITE_NETWORK=swarm-sites             # isolated network; see swarm-site-firewall
SWARM_SITE_SUBNET=172.29.10.0/24
SWARM_SITE_GATEWAY=172.29.10.1
SWARM_SITE_BRIDGE=br-swarm-sites
SWARM_MODEL_RELAY=172.17.0.1:8212          # the only host port a site may reach
SWARM_NGINX_VIA_STAGING=1
SWARM_NGINX_STAGING=/var/lib/swarm/nginx-staging

# Optional: let the platform create DNS records in Cloudflare. Without it,
# point a wildcard record *.SWARM_DOMAIN at this host yourself.
# Put the API token in $SWARM_SECRETS_DIR/cloudflare-token.
#CLOUDFLARE_ZONE_ID=
#SWARM_TUNNEL_ID=                          # CNAME to a Cloudflare tunnel, or
#SWARM_MACHINE_IP=                         # an A record to this IP

# --- platform behaviour ----------------------------------------------------
PLATFORM_PROVISION=1                       # 0: never build real sites
PLATFORM_SITE_PASSWORD=1
PLATFORM_SITE_SCHEDULER=1
ADMIN_ALLOW_DELETE=1

# --- models -------------------------------------------------------------------
# An OpenAI-compatible gateway (for example LiteLLM). Key: secrets/model-key.
PLATFORM_COPILOT=gateway
PLATFORM_MODEL_BASE_URL=http://172.17.0.1:4000/v1
PLATFORM_MODEL_ID=cloud-fast
SITE_MODEL_IDS=cloud-fast
SITE_MODEL_RELAY_URL=http://172.17.0.1:8212/v1

# Optional: Discord ping when a customer conversation needs a human.
# Bot token: secrets/discord-token.
#PLATFORM_NOTIFY_DISCORD_CHANNEL=

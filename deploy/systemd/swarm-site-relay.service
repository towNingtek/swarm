[Unit]
Description=Swarm site model relay (Docker bridge :8212)
After=network-online.target docker.service swarm-platform.service
Wants=network-online.target
Requires=docker.service
# The platform creates the database the relay opens.
Wants=swarm-platform.service

[Service]
User=swarm
Group=swarm
ExecStart=/opt/swarm/deploy/bin/swarm-run relay
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target

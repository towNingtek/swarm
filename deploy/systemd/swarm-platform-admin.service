[Unit]
Description=Swarm admin console (127.0.0.1:8211)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=swarm
Group=swarm
ExecStart=/opt/swarm/deploy/bin/swarm-run admin
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target

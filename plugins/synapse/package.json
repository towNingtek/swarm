{
  "name": "dsh-synapse",
  "version": "0.1.0",
  "description": "synapse（策略神經系統）as a page of a DSH site: /synapse/ behind the site login, Copilot through the site's own DSH session and model menu, plus a 🧠 launcher button.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib/",
    "page/",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/launcher.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}

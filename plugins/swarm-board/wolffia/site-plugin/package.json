{
  "name": "dsh-swarm-board",
  "version": "0.1.0",
  "description": "Swarm board for a DSH site: /board/ page and data behind the site login, plus a 📋 launcher button in the DSH Web client.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/launcher.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "SWARM_BOARD_ORG=acme node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}

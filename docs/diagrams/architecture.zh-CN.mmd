flowchart LR
  browser([浏览器]) -->|"HTTPS"| nginx["nginx"]
  nginx -->|"platform.example.com"| platform["平台 :8210<br/>邀请、登录、平台首页、建站"]
  nginx -->|"platform.example.com/admin"| admin["管理后台 :8211"]
